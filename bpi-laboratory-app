        // The old addSampleRow and removeSampleRow functions are no longer needed. 
        // They are replaced by addPCRSample, startEditPCRSample, cancelPCREdit, removePCRSample, and renderPCRSamples.

        // Evaluate target result based on GMOScreen protocol
        function evaluateTarget(cq, epf, cutoffs, cplusCq, cplusEpf) {
            if (cq === null || cq === '' || isNaN(cq)) {
                return { preliminary: 'negative', reason: 'No Cq' };
            }

            const lowerLimit = cplusCq - cutoffs.cutOff1;
            const upperLimit = cplusCq + cutoffs.cutOff2;
            const epfLimit = cutoffs.epfLimit ? cplusEpf * cutoffs.epfLimit : null;

            // Check EPF first
            if (epfLimit !== null && epf < epfLimit) {
                return { preliminary: 'check amplification!', reason: `EPF (${epf}) < EPF Limit (${epfLimit.toFixed(2)})` };
            }

            // Check Cq ranges
            if (cq >= lowerLimit && cq <= upperLimit) {
                return { preliminary: 'positive', reason: `Cq (${cq}) within cut-off [${lowerLimit.toFixed(2)} - ${upperLimit.toFixed(2)}]` };
            } else if (cq < lowerLimit) {
                return { preliminary: 'check amplification!', reason: `Cq (${cq}) < Cut-off 1 (${lowerLimit.toFixed(2)})` };
            } else { // cq > upperLimit
                if (epfLimit !== null && epf >= epfLimit) {
                    return { preliminary: 'positive', reason: `Cq (${cq}) > Cut-off 2 but EPF (${epf}) >= EPF Limit` };
                }
                return { preliminary: 'negative', reason: `Cq (${cq}) > Cut-off 2 (${upperLimit.toFixed(2)})` };
            }
        }

        // Evaluate IPC result 
        function evaluateIPC(ipcCq, ipcCqNtc, ipcEpfNtc) {
            if (ipcCq === null || ipcCq === '' || isNaN(ipcCq)) {
                return { result: 'invalid', reason: 'No Cq IPC' };
            }

            const lowerLimit = ipcCqNtc - CUTOFFS.IPC.cutOff1;
            const upperLimit = ipcCqNtc + CUTOFFS.IPC.cutOff2;

            if (ipcCq >= lowerLimit && ipcCq <= upperLimit) {
                return { result: 'valid', reason: `IPC Cq (${ipcCq}) within cut-off [${lowerLimit.toFixed(2)} - ${upperLimit.toFixed(2)}]` };
            } else if (ipcCq < lowerLimit) {
                return { result: 'check amplification!', reason: `IPC Cq (${ipcCq}) < Cut-off 1 (${lowerLimit.toFixed(2)})` };
            } else {
                return { result: 'invalid', reason: `IPC Cq (${ipcCq}) > Cut-off 2 (${upperLimit.toFixed(2)})` };
            }
        }

        // Combine preliminary target and IPC results 
        function getFinalResult(preliminaryTarget, ipcResult) {
            // If target is positive, IPC result is irrelevant
            if (preliminaryTarget === 'positive') {
                return { final: 'positive', status: 'positive' };
            }
            if (preliminaryTarget === 'check amplification!') {
                return { final: 'check amplification!', status: 'warning' };
            }
            // Negative target + valid IPC = negative
            if (ipcResult === 'valid') {
                return { final: 'negative', status: 'negative' };
            }
            // Negative target + invalid IPC = inhibited
            if (ipcResult === 'invalid') {
                return { final: 'inhibited', status: 'error' };
            }
            // IPC below range or not run: cannot call negative or inhibited
            return { final: ipcResult === 'not tested' ? 'not tested' : 'check amplification!', status: 'warning' };
        }

        function analyzePCR() { // Analyze PCR data
            // Get positive control values
            const cplus35s = parseFloat(document.getElementById('cplus-35s').value);
            const epf35s = parseFloat(document.getElementById('epf-35s').value);
            const cplusNos = parseFloat(document.getElementById('cplus-nos').value);
            const epfNos = parseFloat(document.getElementById('epf-nos').value);
            const cplusFmv = parseFloat(document.getElementById('cplus-fmv').value);
            const epfFmv = parseFloat(document.getElementById('epf-fmv').value);

            // Get IPC control values
            const ipcCqNtc = parseFloat(document.getElementById('ipc-cq').value);
            const ipcEpfNtc = parseFloat(document.getElementById('ipc-epf').value);

            // Validate required controls
            if (isNaN(cplus35s) || isNaN(epf35s) || isNaN(cplusNos) || isNaN(epfNos) || isNaN(cplusFmv) || isNaN(epfFmv)) {
                showError('pcr-results', 'Please enter Cq and EPF values for all three targets (35S, NOS, FMV).');
                return;
            }

            // Collect sample data from pcrSamples array
            if (pcrSamples.length === 0) {
                showError('pcr-results', 'Please add at least one test sample.');
                return;
            }

            // Without the IPC NTC reference every IPC-tested sample would be wrongly flagged as inhibited
            if (isNaN(ipcCqNtc) && pcrSamples.some(smp => !isNaN(smp.ipcCt))) {
                showError('pcr-results', 'Please enter the IPC Mean Cq (NTC) so samples with an IPC Cq can be evaluated.');
                return;
            }

            // Calculate cut-offs for each target
            const cutoffs35s = { ...CUTOFFS['35S'], cplusCq: cplus35s, cplusEpf: epf35s }; 
            const cutoffsNos = { ...CUTOFFS['NOS'], cplusCq: cplusNos, cplusEpf: epfNos };
            const cutoffsFmv = { ...CUTOFFS['FMV'], cplusCq: cplusFmv, cplusEpf: epfFmv };

            // Build results HTML
            let html = `
                <div class="formula-box" style="margin-top: 1.5rem;">
                    <div class="title">GMOScreen Cut-off Parameters</div>
                    <div class="formula">
                        <table style="width:100%; font-size: 0.875rem;">
                            <tr><th>Target</th><th>Cut-off 1</th><th>Cut-off 2</th><th>EPF Limit</th></tr>
                            <tr><td>35S</td><td>${cplus35s} - 10 = ${(cplus35s - 10).toFixed(2)}</td><td>${cplus35s} + 8 = ${(cplus35s + 8).toFixed(2)}</td><td>${epf35s} × 0.2 = ${(epf35s * 0.2).toFixed(2)}</td></tr>
                            <tr><td>NOS</td><td>${cplusNos} - 10 = ${(cplusNos - 10).toFixed(2)}</td><td>${cplusNos} + 8 = ${(cplusNos + 8).toFixed(2)}</td><td>${epfNos} × 0.2 = ${(epfNos * 0.2).toFixed(2)}</td></tr>
                            <tr><td>FMV</td><td>${cplusFmv} - 10 = ${(cplusFmv - 10).toFixed(2)}</td><td>${cplusFmv} + 9 = ${(cplusFmv + 9).toFixed(2)}</td><td>${epfFmv} × 0.2 = ${(epfFmv * 0.2).toFixed(2)}</td></tr>
                            <tr><td>IPC</td><td>${ipcCqNtc} - 3 = ${(ipcCqNtc - 3).toFixed(2)}</td><td>${ipcCqNtc} + 3 = ${(ipcCqNtc + 3).toFixed(2)}</td><td>No limit</td></tr>
                        </table>
                    </div>
                </div>
                <table class="results-table" style="margin-top: 1rem;">
                    <thead>
                        <tr>
                            <th>Sample</th>
                            <th>35S Cq</th>
                            <th>35S EPF</th>
                            <th>35S Result</th>
                            <th>NOS Cq</th>
                            <th>NOS EPF</th>
                            <th>FMV Cq</th>
                            <th>FMV EPF</th>
                            <th>IPC Cq</th>
                            <th>IPC Result</th>
                            <th>Final Result</th>
                        </tr>
                    </thead>
                    <tbody>
            `;

            pcrSamples.forEach(sample => { // Iterate through the pcrSamples array 
                // Evaluate each target
                const result35s = evaluateTarget(sample.ct35s, sample.epf35s, CUTOFFS['35S'], cplus35s, epf35s);
                const resultNos = evaluateTarget(sample.ctNos, sample.epfNos, CUTOFFS['NOS'], cplusNos, epfNos);
                const resultFmv = evaluateTarget(sample.ctFmv, sample.epfFmv, CUTOFFS['FMV'], cplusFmv, epfFmv);

                // Determine overall target result (positive if any target is positive)
                let preliminaryTarget = 'negative';
                if (result35s.preliminary === 'positive' || resultNos.preliminary === 'positive' || resultFmv.preliminary === 'positive') {
                    preliminaryTarget = 'positive';
                } else if (result35s.preliminary === 'check amplification!' || resultNos.preliminary === 'check amplification!' || resultFmv.preliminary === 'check amplification!') {
                    preliminaryTarget = 'check amplification!';
                }

                // Evaluate IPC
                const ipcResult = sample.ipcCt !== undefined && !isNaN(sample.ipcCt)
                    ? evaluateIPC(sample.ipcCt, ipcCqNtc, ipcEpfNtc)
                    : { result: 'not tested', reason: 'No IPC data' };

                // Get final result 
                const finalResult = getFinalResult(preliminaryTarget, ipcResult.result);

                // Determine badge class
                let badgeClass = 'badge-success';
                let badgeText = 'Negative';
                if (finalResult.final === 'positive') {
                    badgeClass = 'badge-success';
                    badgeText = 'POSITIVE';
                } else if (finalResult.final === 'inhibited') {
                    badgeClass = 'badge-error';
                    badgeText = 'Inhibited';
                } else if (finalResult.final === 'check amplification!') {
                    badgeClass = 'badge-warning';
                    badgeText = 'Check';
                } else if (finalResult.final === 'not tested') {
                    badgeClass = 'badge-warning';
                    badgeText = 'No IPC';
                }

                html += `
                    <tr>
                        <td><strong>${escapeHtml(sample.name)}</strong></td>
                        <td class="number">${sample.ct35s !== undefined && !isNaN(sample.ct35s) ? sample.ct35s : '-'}</td>
                        <td class="number">${sample.epf35s !== undefined && !isNaN(sample.epf35s) ? sample.epf35s : '-'}</td> 
                        <td><span class="badge ${result35s.preliminary === 'positive' ? 'badge-success' : result35s.preliminary === 'check amplification!' ? 'badge-warning' : 'badge-error'}">${result35s.preliminary}</span></td>
                        <td class="number">${sample.ctNos !== undefined && !isNaN(sample.ctNos) ? sample.ctNos : '-'}</td>
                        <td class="number">${sample.epfNos !== undefined && !isNaN(sample.epfNos) ? sample.epfNos : '-'}</td>
                        <td class="number">${sample.ctFmv !== undefined && !isNaN(sample.ctFmv) ? sample.ctFmv : '-'}</td>
                        <td class="number">${sample.epfFmv !== undefined && !isNaN(sample.epfFmv) ? sample.epfFmv : '-'}</td>
                        <td class="number">${sample.ipcCt !== undefined && !isNaN(sample.ipcCt) ? sample.ipcCt : '-'}</td>
                        <td><span class="badge ${ipcResult.result === 'valid' ? 'badge-success' : ipcResult.result === 'invalid' ? 'badge-error' : 'badge-warning'}">${ipcResult.result}</span></td>
                        <td><span class="badge ${badgeClass}">${badgeText}</span></td>
                    </tr>
                `;
            });

            html += `
                    </tbody> 
                </table>
                <div class="formula-box" style="margin-top: 1.5rem;">
                    <div class="title">Evaluation Logic</div>
                    <div class="formula" style="font-size: 0.875rem;">
                        <strong>Target Evaluation:</strong> Cq within [C+ - cut-off1, C+ + cut-off2] AND EPF ≥ EPF Limit → Positive<br>
                        <strong>IPC Evaluation:</strong> IPC Cq within [NTC - 3, NTC + 3] → Valid<br>
                        <strong>Final Rule:</strong> If target = positive → Final = positive (IPC irrelevant)<br>
                        &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;If target = negative + IPC valid → Final = negative<br>
                        &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;If target = negative + IPC invalid → Final = inhibited<br>
                        &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;If target = negative + IPC below range or not run → Final = check
                    </div>
                </div>
            `;

            document.getElementById('pcr-results').innerHTML = html;
            triggerFireworks(window.event);
        }

        function clearPCR() { // Clear all PCR data
            // Clear control inputs
            document.getElementById('cplus-35s').value = '';
            document.getElementById('epf-35s').value = '';
            document.getElementById('cplus-nos').value = '';
