        async function fetchShared() {
            try {
                const r = await fetch('/api/presets', { cache: 'no-store' });
                if (!r.ok) throw new Error('offline');
                const j = await r.json();
                sharedPresets = Array.isArray(j.presets) ? j.presets : [];
                sharedOnline = true;
            } catch (e) { sharedPresets = []; sharedOnline = false; }
            renderPresets();
        }
        async function sharedRequest(method, url, body) {
            for (let attempt = 0; attempt < 2; attempt++) {
                let r;
                try { r = await fetch(url, { method, headers: { 'content-type': 'application/json', 'x-pin': labPin }, body: body ? JSON.stringify(body) : undefined }); } catch (e) { return { ok: false }; }
                if (r.status === 401) {
                    const pin = prompt('Enter the lab PIN to change shared presets:');
                    if (pin === null) return null;
                    labPin = pin; continue;
                }
                return r;
            }
            return { ok: false };
        }
        const findPreset = (v) => (v[0] === 's' ? sharedPresets : localPresets()).find(pr => pr.id === v.slice(2));
        $('preset-load').onclick = () => {
            const pr = findPreset($('preset-select').value);
            if (!pr) { toast('Choose a preset first'); return; }
            Object.entries(PRESET_FIELDS).forEach(([id, k]) => { if (pr.data[k] !== undefined && $(id)) $(id).value = pr.data[k]; });
            updateCocktailWater(); scheduleSave(); toast(`Loaded “${pr.name}”`);
        };
        $('preset-save').onclick = async () => {
            const name = $('preset-name').value.trim();
            if (!name) { toast('Name the preset first'); return; }
            const data = Object.fromEntries(Object.entries(PRESET_FIELDS).map(([id, k]) => [k, $(id).value]));
            if ($('preset-share').checked) {
                const r = await sharedRequest('POST', '/api/presets', { name, data });
                if (!r) return;
                if (!r.ok) { toast('Could not save to shared presets'); return; }
                await fetchShared(); $('preset-name').value = ''; toast('Shared with the whole lab ✓');
            } else {
                const list = localPresets().filter(pr => pr.id !== slugify(name));
                list.push({ id: slugify(name), name, data, updatedAt: Date.now() });
                safeStorage.set(LOCAL_PRESETS_KEY, JSON.stringify(list)); renderPresets(); $('preset-name').value = ''; toast('Saved on this computer ✓');
            }
        };
        $('preset-delete').onclick = async () => {
            const v = $('preset-select').value, pr = v && findPreset(v);
            if (!pr) { toast('Choose a preset first'); return; }
            if (!confirm(`Delete preset “${pr.name}”${v[0] === 's' ? ' for everyone in the lab' : ''}?`)) return;
            if (v[0] === 's') {
                const r = await sharedRequest('DELETE', `/api/presets?id=${encodeURIComponent(pr.id)}`);
                if (!r) return;
                if (!r.ok) { toast('Could not delete shared preset'); return; }
                await fetchShared();
            } else {
                safeStorage.set(LOCAL_PRESETS_KEY, JSON.stringify(localPresets().filter(x => x.id !== pr.id))); renderPresets();
            }
            toast('Preset deleted');
        };
        fetchShared();
        window.addEventListener('focus', fetchShared);

        // ---- Lab tools: run history, backup, run sheet, CSV ----
        const RUNS_KEY = 'biotech_runs';
        const getRuns = () => { try { return JSON.parse(safeStorage.get(RUNS_KEY, '[]')); } catch (e) { return []; } };
        const captureState = () => ({ t: $('experiment-title').value, d: dilutionSamples, p: pcrSamples, w: plateState, f: Object.fromEntries(FIELD_IDS.map(id => [id, $(id) && $(id).value])) });
        function applyState(st) {
            $('experiment-title').value = st.t || ''; safeStorage.set('qpcr_experiment_title', st.t || '');
            Object.entries(st.f || {}).forEach(([id, v]) => { const el = $(id); if (el && v !== undefined && v !== null) el.value = v; });
            dilutionSamples = st.d || []; pcrSamples = (st.p || []).map(reviveSample); plateState = st.w || {}; selectedWells.clear();
            renderDilutionSamples(); renderPCRSamples(); renderPlateGrid(); updateCocktailWater(); updateTabBadges(); scheduleSave();
        }
        function buildPlateSheet() {
            if (!Object.keys(plateState).some(k => !k.includes('-') && plateState[k].label)) return '';
            const head = '<tr><th></th>' + plateColumns.map(c => `<th>${c}</th>`).join('') + '</tr>';
            const body = plateRows.map(r => `<tr><th>${r}</th>` + plateColumns.map(c => {
                const e = plateState[r + c];
                return e ? `<td style="background:${escapeHtml(e.color)};color:${getContrastColor(e.color)};text-align:center;font-size:7pt;height:.3in">${escapeHtml(e.label)}</td>` : '<td></td>';
            }).join('') + '</tr>').join('');
            return `<h3 style="margin:14px 0 4px;font-size:10pt">${escapeHtml($('plate-title').value || 'Plate map')}</h3><table style="width:auto;min-width:6.5in">${head + body}</table>`;
        }
        const dlg = document.createElement('dialog');
        dlg.className = 'lab-dialog';
        dlg.innerHTML = `
            <div style="display:flex;justify-content:space-between;align-items:center"><h2>Lab tools</h2><button class="btn btn-secondary" type="button" id="lt-close">Close</button></div>
            <h3>RUN HISTORY</h3>
            <div class="preset-bar"><input type="text" id="run-name" placeholder="Run name" style="flex:1;min-width:180px"><button class="btn btn-primary" type="button" id="run-save">Save current run</button></div>
            <div id="run-list" style="margin-top:.9rem"></div>
            <h3>SHARE &amp; EXPORT</h3>
            <div class="btn-group">
                <button class="btn btn-secondary" type="button" id="lt-sheet">🖨️ Print run sheet</button>
                <button class="btn btn-secondary" type="button" id="lt-platecsv">Plate CSV</button>
                <button class="btn btn-secondary" type="button" id="lt-export">Export backup</button>
                <label class="btn btn-secondary" style="cursor:pointer">Import backup<input type="file" id="lt-import" accept=".json,application/json" hidden></label>
            </div>`;
        document.body.appendChild(dlg);
        function renderRuns() {
            const runs = getRuns();
            $('run-list').innerHTML = runs.length ? runs.map(r => `<div class="run-row"><div class="grow"><strong>${escapeHtml(r.name)}</strong><br><small>${new Date(r.at).toLocaleString()} · ${(r.state.d || []).length} dilutions · ${Object.keys(r.state.w || {}).filter(k => !k.includes('-')).length} wells</small></div><button class="btn btn-secondary" type="button" data-run="restore:${r.id}">Restore</button><button class="btn-icon" type="button" title="Delete" data-run="del:${r.id}">✕</button></div>`).join('') : '<div class="empty-state"><p>No saved runs yet.</p></div>';
        }
        const toolsBtn = document.createElement('button');
        toolsBtn.type = 'button'; toolsBtn.className = 'theme-toggle tools'; toolsBtn.textContent = '📚'; toolsBtn.title = 'Lab tools: run history, backup, run sheet';
        toolsBtn.setAttribute('aria-label', 'Open lab tools');
        toolsBtn.onclick = () => { $('run-name').value = $('experiment-title').value.trim(); renderRuns(); dlg.showModal(); };
        document.querySelector('.app-header').appendChild(toolsBtn);
        $('lt-close').onclick = () => dlg.close();
        dlg.addEventListener('click', (e) => { if (e.target === dlg) dlg.close(); });
        $('run-save').onclick = () => {
            const runs = getRuns();
            runs.unshift({ id: Date.now().toString(36), name: $('run-name').value.trim() || $('experiment-title').value.trim() || 'Untitled run', at: Date.now(), state: JSON.parse(JSON.stringify(captureState())) });
            safeStorage.set(RUNS_KEY, JSON.stringify(runs.slice(0, 50)));
            renderRuns(); toast('Run saved ✓');
        };
        $('run-list').addEventListener('click', (e) => {
            const btn = e.target.closest('[data-run]');
            if (!btn) return;
            const [action, id] = btn.dataset.run.split(':');
            const runs = getRuns(), run = runs.find(r => r.id === id);
            if (!run) return;
            if (action === 'restore') {
                if (!confirm(`Replace the current work with “${run.name}”?`)) return;
                applyState(run.state); dlg.close(); toast(`Restored “${run.name}”`);
            } else if (confirm(`Delete saved run “${run.name}”?`)) {
                safeStorage.set(RUNS_KEY, JSON.stringify(runs.filter(r => r.id !== id))); renderRuns();
            }
        });
        $('lt-sheet').onclick = () => {
            openNotePrintWindow(($('experiment-title').value || 'Run sheet').trim(),
                `<div style="display:flex;gap:.25in;align-items:flex-start;flex-wrap:wrap">${dilutionSamples.length ? buildDilutionPrintableHtml() : ''}${buildCocktailPrintableHtml()}</div>${buildPlateSheet()}`);
        };
        $('lt-platecsv').onclick = () => {
            const rows = [['Well', 'Label', 'Color']];
            plateRows.forEach(r => plateColumns.forEach(c => { const e = plateState[r + c]; if (e && e.label) rows.push([r + c, e.label, e.color]); }));
            if (rows.length === 1) { toast('No labeled wells yet'); return; }
            download(`plate-${today()}.csv`, '\uFEFF' + rows.map(r => r.map(csvCell).join(',')).join('\r\n'), 'text/csv;charset=utf-8');
        };
        $('lt-export').onclick = () => download(`biotech-lab-backup-${today()}.json`, JSON.stringify({ app: 'biotech-lab', v: 1, state: captureState(), runs: getRuns(), presets: localPresets() }), 'application/json');
        $('lt-import').onchange = async (e) => {
            const file = e.target.files[0];
            if (!file) return;
            try {
                const j = JSON.parse(await file.text());
                if (j.app !== 'biotech-lab') throw new Error('bad file');
                const merge = (a, b) => [...new Map([...a, ...b].map(x => [x.id, x])).values()];
                safeStorage.set(RUNS_KEY, JSON.stringify(merge(getRuns(), j.runs || []).slice(0, 50)));
                safeStorage.set(LOCAL_PRESETS_KEY, JSON.stringify(merge(localPresets(), j.presets || [])));
                if (j.state) applyState(j.state);
                renderRuns(); renderPresets(); toast('Backup restored ✓');
            } catch (err) { toast('That file is not a valid backup'); }
            e.target.value = '';
        };

        // ==================== DESIGN V2: app shell ====================
        (function () {
            const tabs = document.querySelector('.tabs'), header = document.querySelector('.app-header');
            const side = document.createElement('aside');
            side.className = 'sidebar';
            side.innerHTML = '<div class="brand"><svg viewBox="0 0 32 32" aria-hidden="true"><rect width="32" height="32" rx="9" fill="#3b5bff"/><path d="M16 6.500c3.200 4.600 6.500 7.500 6.500 11.500a6.500 6.500 0 0 1-13 0c0-4 3.300-6.900 6.500-11.500z" fill="#fff"/><circle cx="14" cy="19" r="1.600" fill="#3b5bff"/></svg><div><b>BioLab</b><small>Office Laboratory</small></div></div><div class="sidebar-actions"></div>';
            const actions = side.querySelector('.sidebar-actions');
            side.insertBefore(tabs, actions);
            themeBtn.title = 'Switch light / dark theme';
            actions.append(toolsBtn, themeBtn);
            document.body.prepend(side);
            const chip = document.createElement('span');
            chip.className = 'date-chip';
            const hr = new Date().getHours();
            chip.textContent = (hr < 12 ? '🌅 Good morning' : hr < 18 ? '🌿 Good afternoon' : '🌙 Good evening') + ' · ' + new Date().toLocaleDateString(undefined, { weekday: 'short', day: 'numeric', month: 'short' });
            header.appendChild(chip);
        })();

        const renderPlateV2 = window.renderPlateGrid;
        window.renderPlateGrid = function (...args) {
            const out = renderPlateV2.apply(this, args);
            plateGridEl.querySelectorAll('[data-well]').forEach(c => { const e = plateState[c.dataset.well]; c.title = c.dataset.well + (e && e.label ? ' · ' + e.label : ''); });
            return out;
        };
        renderPlateGrid();

        // Slide the glass bubble under the active tab (phone nav)
        (function () {
            const tabsEl = document.querySelector('.tabs');
            const place = () => {
                const t = tabsEl.querySelector('.tab.active');
                if (!t) return;
                tabsEl.style.setProperty('--x', t.offsetLeft + 'px');
                tabsEl.style.setProperty('--w', t.offsetWidth + 'px');
                tabsEl.style.setProperty('--y', t.offsetTop + 'px');
                tabsEl.style.setProperty('--h', t.offsetHeight + 'px');
            };
            new MutationObserver(place).observe(tabsEl, { subtree: true, attributes: true, attributeFilter: ['class'] });
            window.addEventListener('resize', place);
            window.addEventListener('load', place);
            setTimeout(place, 80);
            place();
        })();
    </script>
</body>
</html>
