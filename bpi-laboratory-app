            document.getElementById('pcr-sample-name').value = '';
            document.getElementById('pcr-target-ct-35s').value = '';
            document.getElementById('pcr-target-epf-35s').value = '';
            document.getElementById('pcr-target-ct-nos').value = '';
            document.getElementById('pcr-target-epf-nos').value = '';
            document.getElementById('pcr-target-ct-fmv').value = '';
            document.getElementById('pcr-target-epf-fmv').value = '';
            document.getElementById('pcr-ipc-ct').value = '';
        }

        function blankIfNaN(v) { return (v === undefined || v === null || Number.isNaN(v)) ? '' : v; }

        function addPCRSample() { // Add or update PCR sample
            const name = document.getElementById('pcr-sample-name').value || `Sample ${pcrSamples.length + 1}`;
            const ct35s = parseFloat(document.getElementById('pcr-target-ct-35s').value);
            const epf35s = parseFloat(document.getElementById('pcr-target-epf-35s').value);
            const ctNos = parseFloat(document.getElementById('pcr-target-ct-nos').value);
            const epfNos = parseFloat(document.getElementById('pcr-target-epf-nos').value);
            const ctFmv = parseFloat(document.getElementById('pcr-target-ct-fmv').value);
            const epfFmv = parseFloat(document.getElementById('pcr-target-epf-fmv').value);
            const ipcCt = parseFloat(document.getElementById('pcr-ipc-ct').value);

            if (![ct35s, epf35s, ctNos, epfNos, ctFmv, epfFmv, ipcCt].some(v => !isNaN(v))) {
                showError('pcr-results', 'Enter at least one Cq or EPF value before adding a sample.');
                return;
            }

            const newSample = {
                id: pcrEditingIndex !== null ? pcrSamples[pcrEditingIndex].id : Date.now(),
                name,
                ct35s, epf35s,
                ctNos, epfNos,
                ctFmv, epfFmv,
                ipcCt
            };

            if (pcrEditingIndex !== null) {
                pcrSamples[pcrEditingIndex] = newSample;
            } else {
                pcrSamples.push(newSample);
            }

            clearPCRInputForm();
            pcrEditingIndex = null;
            setPCREditMode(false);
            renderPCRSamples();
        }

        function startEditPCRSample(index) { // Start editing a PCR sample
            const sample = pcrSamples[index];
            if (!sample) return;

            pcrEditingIndex = index;
            setPCREditMode(true);

            document.getElementById('pcr-sample-name').value = sample.name || '';
            document.getElementById('pcr-target-ct-35s').value = blankIfNaN(sample.ct35s);
            document.getElementById('pcr-target-epf-35s').value = blankIfNaN(sample.epf35s);
            document.getElementById('pcr-target-ct-nos').value = blankIfNaN(sample.ctNos);
            document.getElementById('pcr-target-epf-nos').value = blankIfNaN(sample.epfNos);
            document.getElementById('pcr-target-ct-fmv').value = blankIfNaN(sample.ctFmv);
            document.getElementById('pcr-target-epf-fmv').value = blankIfNaN(sample.epfFmv);
            document.getElementById('pcr-ipc-ct').value = blankIfNaN(sample.ipcCt);

            document.getElementById('pcr-sample-name').focus();
        }

        function cancelPCREdit() { // Cancel PCR edit
            clearPCRInputForm();
            pcrEditingIndex = null;
            setPCREditMode(false);
        }

        function removePCRSample(index) {
            pcrSamples.splice(index, 1);
            if (pcrEditingIndex !== null) {
                if (pcrEditingIndex === index) {
                    cancelPCREdit();
                } else if (pcrEditingIndex > index) {
                    pcrEditingIndex -= 1;
                }
            }
            renderPCRSamples();
        }

