    <script>
        // Tab Navigation
        function switchTab(tabId, tabElement) {
            document.querySelectorAll('.tab').forEach(t => t.classList.remove('active'));
            document.querySelectorAll('.panel').forEach(p => p.classList.remove('active'));
            tabElement.classList.add('active');
            tabElement.scrollIntoView({ inline: 'center', block: 'nearest', behavior: 'smooth' });
            const panel = document.getElementById(tabId);
            if (panel) panel.classList.add('active');
        }

        // localStorage can throw (sandboxed iframes, privacy modes). Never let that kill the app.
        const safeStorage = {
            get(key, fallback = null) {
                try { const v = localStorage.getItem(key); return v === null ? fallback : v; } catch (e) { return fallback; }
            },
            set(key, value) {
                try { localStorage.setItem(key, value); } catch (e) { /* storage unavailable */ }
            }
        };

        // Record keeping: persist experiment title for printing
        const experimentTitleInput = document.getElementById('experiment-title');
        if (experimentTitleInput) {
            experimentTitleInput.value = safeStorage.get('qpcr_experiment_title', '');
            experimentTitleInput.addEventListener('input', () => {
                safeStorage.set('qpcr_experiment_title', experimentTitleInput.value || '');
            });
        }

        const DRAFTS_STORAGE_KEY = 'biotech_office_laboratory_drafts';

        function loadSavedDrafts() {
            try {
                const parsed = JSON.parse(safeStorage.get(DRAFTS_STORAGE_KEY, '[]'));
                return Array.isArray(parsed) ? parsed : [];
            } catch {
                return [];
            }
        }

        function getActivePanelId() {
            const activePanel = document.querySelector('.panel.active');
            return activePanel ? activePanel.id : 'dilution';
        }

        function renderDraftList() {
            const host = document.getElementById('draft-list');
            if (!host) return;
            const drafts = loadSavedDrafts();
            if (!drafts.length) {
                host.innerHTML = '<div class="empty-state"><p>No saved drafts yet.</p></div>';
                return;
            }
            host.innerHTML = `
                <div class="btn-group" style="margin-bottom: 0.75rem;">
                    <button class="btn btn-secondary" type="button" onclick="deleteSelectedDrafts()">Delete Selected</button>
                    <button class="btn btn-secondary" type="button" onclick="selectAllDrafts()">Select All</button>
                    <button class="btn btn-secondary" type="button" onclick="clearSelectedDrafts()">Clear Selection</button>
                </div>
                ${drafts.map((draft, index) => `
                    <label class="sample-row" style="margin-bottom: 0.75rem; display:flex; align-items:flex-start; gap:0.75rem;">
                        <input type="checkbox" class="draft-select" data-index="${index}" style="margin-top:0.35rem;">
                        <div class="form-group" style="flex: 1; min-width: 180px;">
                            <label>${escapeHtml(draft.title || 'Untitled experiment')} · ${escapeHtml(draft.kind || 'dilution')}</label>
                            <div class="unit">${new Date(draft.savedAt).toLocaleString()}</div>
                        </div>
                        <div class="btn-group">
                            <button class="btn btn-secondary" type="button" onclick="restoreDraft(${index})">Restore</button>
                            <button class="btn btn-secondary" type="button" onclick="deleteDraft(${index})">Delete</button>
                        </div>
                    </label>
                `).join('')}
            `;
        }

        function saveCurrentDraft() {
            const drafts = loadSavedDrafts();
            const kind = getActivePanelId();
            const baseTitle = (document.getElementById('experiment-title')?.value || '').trim() || 'Untitled experiment';
            const draft = {
                title: baseTitle,
                kind,
                savedAt: new Date().toISOString()
            };
            if (kind === 'dilution') {
                draft.dilutionSamples = JSON.parse(JSON.stringify(dilutionSamples));
            } else if (kind === 'cocktail') {
                draft.cocktail = {
                    reactions: document.getElementById('cocktail-reactions')?.value || '',
                    vol: document.getElementById('cocktail-vol')?.value || '',
                    extra: document.getElementById('cocktail-extra')?.value || '',
                    master: document.getElementById('comp-master')?.value || '',
                    masterStock: document.getElementById('comp-master-stock')?.value || '',
                    fwd: document.getElementById('comp-fwd')?.value || '',
                    fwdStock: document.getElementById('comp-fwd-stock')?.value || '',
                    rev: document.getElementById('comp-rev')?.value || '',
                    revStock: document.getElementById('comp-rev-stock')?.value || '',
                    probe: document.getElementById('comp-probe')?.value || '',
                    probeStock: document.getElementById('comp-probe-stock')?.value || '',
                    sample: document.getElementById('comp-sample')?.value || '',
                    dna: document.getElementById('comp-dna-concentration')?.value || '',
                    water: document.getElementById('comp-water')?.value || ''
                };
            } else if (kind === 'plate') {
                draft.plateState = JSON.parse(JSON.stringify(plateState));
                draft.plateTitle = document.getElementById('plate-title')?.value || '';
            } else if (kind === 'analysis') {
                draft.pcrSamples = JSON.parse(JSON.stringify(pcrSamples));
            }
            drafts.unshift(draft);
            safeStorage.set(DRAFTS_STORAGE_KEY, JSON.stringify(drafts));
            renderDraftList();
        }

        function restoreDraft(index) {
            const drafts = loadSavedDrafts();
            const draft = drafts[index];
            if (!draft) return;
            const title = document.getElementById('experiment-title');
            if (title) title.value = draft.title || '';
            if (draft.kind === 'dilution') {
                dilutionSamples = Array.isArray(draft.dilutionSamples) ? draft.dilutionSamples : [];
                dilutionEditingIndex = null;
                renderDilutionSamples();
            } else if (draft.kind === 'cocktail' && draft.cocktail) {
                const fieldMap = {
                    'cocktail-reactions': 'reactions', 'cocktail-vol': 'vol', 'cocktail-extra': 'extra',
                    'comp-master': 'master', 'comp-master-stock': 'masterStock',
                    'comp-fwd': 'fwd', 'comp-fwd-stock': 'fwdStock',
                    'comp-rev': 'rev', 'comp-rev-stock': 'revStock',
                    'comp-probe': 'probe', 'comp-probe-stock': 'probeStock',
                    'comp-sample': 'sample', 'comp-dna-concentration': 'dna'
                };
                Object.entries(fieldMap).forEach(([id, key]) => {
                    const el = document.getElementById(id);
                    if (el && draft.cocktail[key] !== undefined) el.value = draft.cocktail[key];
                });
                updateCocktailWater();
            } else if (draft.kind === 'plate') {
                plateState = draft.plateState && typeof draft.plateState === 'object' ? draft.plateState : {};
                const plateTitle = document.getElementById('plate-title');
                if (plateTitle) plateTitle.value = draft.plateTitle || '';
                renderPlateGrid();
            } else if (draft.kind === 'analysis') {
                pcrSamples = Array.isArray(draft.pcrSamples) ? draft.pcrSamples.map(reviveSample) : [];
                pcrEditingIndex = null;
                renderPCRSamples();
            }
        }

        function deleteDraft(index) {
            const drafts = loadSavedDrafts();
            drafts.splice(index, 1);
            safeStorage.set(DRAFTS_STORAGE_KEY, JSON.stringify(drafts));
            renderDraftList();
        }

        function selectAllDrafts() {
            document.querySelectorAll('.draft-select').forEach((el) => { el.checked = true; });
        }

        function clearSelectedDrafts() {
            document.querySelectorAll('.draft-select').forEach((el) => { el.checked = false; });
        }

        function deleteSelectedDrafts() {
            const selected = Array.from(document.querySelectorAll('.draft-select:checked')).map((el) => Number(el.dataset.index)).filter(Number.isFinite).sort((a, b) => b - a);
            if (!selected.length) return;
            const drafts = loadSavedDrafts();
            selected.forEach((index) => drafts.splice(index, 1));
            safeStorage.set(DRAFTS_STORAGE_KEY, JSON.stringify(drafts));
            renderDraftList();
        }

