        // ==================== COCKTAIL CALCULATOR ====================
        function computeCocktailWater(finalReactionVol, master, fwd, rev, probe, sample) {
            const finalVol = Number(finalReactionVol) || 0;
            const sampleVol = Number(sample) || 0;
            const mixTarget = Math.max(0, finalVol - sampleVol); // volume dispensed into tube before adding sample
            const nonWaterCocktail = (Number(master) || 0) + (Number(fwd) || 0) + (Number(rev) || 0) + (Number(probe) || 0);
            const raw = mixTarget - nonWaterCocktail;
            return {
                mixTarget,
                water: Math.max(0, raw),
                overage: Math.max(0, -raw)
            };
        }

        function updateCocktailWater() {
            const reactionVol = parseFloat(document.getElementById('cocktail-vol').value) || 0;
            const master = parseFloat(document.getElementById('comp-master').value) || 0;
            const fwd = parseFloat(document.getElementById('comp-fwd').value) || 0;
            const rev = parseFloat(document.getElementById('comp-rev').value) || 0;
            const probe = parseFloat(document.getElementById('comp-probe').value) || 0;
            const sample = parseFloat(document.getElementById('comp-sample').value) || 0;

            const { water } = computeCocktailWater(reactionVol, master, fwd, rev, probe, sample);
            document.getElementById('comp-water').value = String(water);
        }

