                .total td, .strong { font-weight: bold; }
            `;
        }

        function getPrintNoteStyles() {
            return `
                @page { size: auto; margin: 0.5in; }
                body { font-family: Arial, sans-serif; font-size: 9pt; color: #111; padding: 20px; }
                .note { border: 1px solid #111; padding: 14px; width: 4.5in; box-sizing: border-box; }
