        function addDilutionSample() {
            const name = document.getElementById('dil-sample-name').value || `Sample ${dilutionSamples.length + 1}`;
            const c1 = parseFloat(document.getElementById('dil-c1').value);
            const v2 = parseFloat(document.getElementById('dil-v2').value);
            
            // Get C2 from the fixed field or from existing samples (since it's fixed for all)
            let c2 = parseFloat(document.getElementById('dil-fixed-c2').value);
            if (isNaN(c2) && dilutionSamples.length > 0) {
