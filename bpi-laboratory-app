        async function captureHtml(html, width = 900) {
            const host = document.createElement('div');
            host.style.position = 'fixed';
            host.style.left = '-10000px';
            host.style.top = '0';
            host.style.width = `${width}px`;
            host.style.background = '#ffffff';
            host.style.pointerEvents = 'none';
            host.style.zIndex = '2147483647';
            const exportNode = document.createElement('div');
            exportNode.className = 'force-light';
            exportNode.style.width = `${width}px`;
            exportNode.style.background = '#ffffff';
            exportNode.innerHTML = `<style>${getPictureExportStyles()}</style>${html}`;
            host.appendChild(exportNode);
            document.body.appendChild(host);
            try {
                await new Promise((resolve) => requestAnimationFrame(resolve));
                if (typeof html2canvas !== 'undefined') {
                    return await html2canvas(exportNode, {
                        backgroundColor: '#ffffff',
                        scale: 2,
                        useCORS: true,
                        allowTaint: false,
                        logging: false
                    });
                }
                const rect = exportNode.getBoundingClientRect();
                const exportWidth = Math.ceil(rect.width || width);
                const exportHeight = Math.ceil(exportNode.scrollHeight || rect.height || 600);
                const xhtml = new XMLSerializer().serializeToString(exportNode);
                const svg = `
                    <svg xmlns="http://www.w3.org/2000/svg" width="${exportWidth}" height="${exportHeight}">
                        <foreignObject width="100%" height="100%">
                            ${xhtml}
                        </foreignObject>
                    </svg>
                `;
                const blob = new Blob([svg], { type: 'image/svg+xml;charset=utf-8' });
                const url = URL.createObjectURL(blob);
                const image = new Image();
                await new Promise((resolve, reject) => {
                    image.onload = resolve;
                    image.onerror = reject;
                    image.src = url;
                });
                const canvas = document.createElement('canvas');
                canvas.width = exportWidth * 2;
                canvas.height = exportHeight * 2;
                const ctx = canvas.getContext('2d');
                ctx.scale(2, 2);
                ctx.fillStyle = '#ffffff';
                ctx.fillRect(0, 0, exportWidth, exportHeight);
                ctx.drawImage(image, 0, 0);
                URL.revokeObjectURL(url);
                return canvas;
            } finally {
                host.remove();
            }
        }

        async function exportCanvas(canvas, filenamePrefix) {
            if (!canvas) return;
            const fileBase = `${filenamePrefix}-${new Date().toISOString().slice(0, 10)}`;
            canvas.toBlob((blob) => {
                if (!blob) return;
                const url = URL.createObjectURL(blob);
                const a = document.createElement('a');
                a.href = url;
                a.download = `${fileBase}.jpg`;
                document.body.appendChild(a);
                a.click();
                a.remove();
                setTimeout(() => URL.revokeObjectURL(url), 1000);
            }, 'image/jpeg', 0.95);
        }

        async function exportPanel(panelId, filenamePrefix) {
            const panel = document.getElementById(panelId);
            if (!panel) return;
            // outerHTML only serialises the value *attribute*, so copy live input values onto a clone first
            const clone = panel.cloneNode(true);
            const liveFields = panel.querySelectorAll('input, select, textarea');
            const cloneFields = clone.querySelectorAll('input, select, textarea');
            liveFields.forEach((el, i) => {
                const c = cloneFields[i];
                if (!c) return;
                if (el.tagName === 'SELECT') {
                    Array.from(c.options).forEach((o, j) => o.toggleAttribute('selected', j === el.selectedIndex));
                } else if (el.type === 'checkbox' || el.type === 'radio') {
                    c.toggleAttribute('checked', el.checked);
                } else {
                    c.setAttribute('value', el.value);
                }
            });
            const canvas = await captureHtml(clone.outerHTML);
            if (!canvas) return;
            await exportCanvas(canvas, filenamePrefix);
        }

